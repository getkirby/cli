{
	"name": "getkirby/cli",
	"description": "Kirby command line interface",
	"license": "MIT",
	"version": "1.10.0",
	"keywords": [
		"kirby",
		"cms",
		"cli",
		"command"
	],
	"authors": [
		{
			"name": "Kirby Team",
			"email": "support@getkirby.com",
			"homepage": "https://getkirby.com"
		}
	],
	"homepage": "https://getkirby.com",
	"support": {
		"email": "support@getkirby.com",
		"issues": "https://github.com/getkirby/cli/issues",
		"forum": "https://forum.getkirby.com",
		"source": "https://github.com/getkirby/cli"
	},
	"require": {
		"php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
		"ext-zip": "*",
		"composer-runtime-api": "^2.2",
		"guzzlehttp/guzzle": "^7.15.5",
		"league/climate": "^3.12.0"
	},
	"autoload": {
		"psr-4": {
			"Kirby\\": [
				"src/",
				"tests/"
			]
		}
	},
	"bin": [
		"bin/kirby"
	],
	"config": {
		"optimize-autoloader": true
	},
	"scripts": {
		"analyze": [
			"@analyze:composer",
			"@analyze:psalm"
		],
		"analyze:composer": "composer validate --strict --no-check-version --no-check-all",
		"analyze:psalm": "cpx vimeo/psalm:6.16.1",
		"ci": [
			"@fix",
			"@analyze",
			"@test"
		],
		"fix": "cpx getkirby/php-cs:^0.2 fix",
		"test": "cpx phpunit/phpunit:12.5.34"
	}
}
